export component DesktopShell inherits Window {
    title: "Tanoshi DE Shell";
    no-frame: true;
    background: #0f172a;

    in-out property <string> current-time: "12:00";
    callback launcher-clicked();

    HorizontalLayout {
        padding: 8px;
        spacing: 16px;

        Rectangle {
            width: 120px;
            height: 26px;
            background: touch-launcher.pressed ? #3b82f6 : #1e293b;
            border-radius: 6px;

            Text {
                text: "APP_LAUNCHER";
                color: white;
                font-size: 14px;
            }

            touch-launcher := TouchArea {
                width: 120px;
                height: 26px;

                clicked => {
                    root.launcher-clicked();
                }
            }
        }

        // Spacer element to push items apart
        Rectangle {}

        // System Clock
        VerticalLayout {
            alignment: center;
            Text { text: root.current-time; color: #f8fafc; font-size: 13px; }
        }
    }
}
